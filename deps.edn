{:paths ["src"]
 :version "0.1.0"
 ;; kotoba-lang/lint — EDN source linter/formatter. Consumes fmt (canonicalize),
 ;; lsp (diagnostics), fs (read source files), coll (result shaping). A real
 ;; consumer of fmt and lsp (M5 for both). No third-party deps; .cljc.
 ;; See ADR-kotoba-lang-foundational-stdlib.md.
 :deps {io.github.kotoba-lang/fmt  {:git/sha "d5fa06ead08843a6e23198c415e0d0179b24a414"}
        io.github.kotoba-lang/lsp  {:git/sha "8d055a0388da283a82adb1be556139d6d0ec755a"}
        io.github.kotoba-lang/fs   {:git/sha "e3a7cd798669a86b1627b827fcf51ff77926947b"}
        io.github.kotoba-lang/coll {:git/sha "9740cc2dc43a192077d77374b869a37940c801e4"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
