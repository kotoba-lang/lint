{:paths ["src"]
 :version "0.1.0"
 ;; kotoba-lang/lint — EDN source linter/formatter. Consumes fmt (canonicalize),
 ;; lsp (diagnostics), fs (read source files), coll (result shaping). A real
 ;; consumer of fmt and lsp (M5 for both). No third-party deps; .cljc.
 ;; See ADR-kotoba-lang-foundational-stdlib.md.
 :deps {
        ;; kotoba.lang.edn, not clojure.edn. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/edn {:git/sha "b8a2a05876638442270956334e1e0d6328531b1b"}
       
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/fmt  {:git/sha "6b6ed48759168c19803031d4ae9f2c6870960165"}
        io.github.kotoba-lang/lsp  {:git/sha "e1b221d4e7a25894ea5717dfa477dbffea2826e8"}
        io.github.kotoba-lang/fs   {:git/sha "91bf896d6d64e9f73fa71083d41aa9fc02520ba2"}
        io.github.kotoba-lang/coll {:git/sha "563f9e8911885170a2ffb44502c2f68764b9e0a9"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
